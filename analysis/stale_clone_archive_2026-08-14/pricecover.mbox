+/// Legal moves for the advisor's OWN board (never a search clone), with
+/// `Move::PrepareEvent` removed unless something has already confirmed which
+/// card the reveal resolves to. `Advisor::play` refuses to COMMIT that move
+/// for exactly this reason (see its own doc comment on `Board::
+/// confirmed_events`); if candidate generation didn't apply the identical
+/// rule, the bot would keep starring a move it will never let the operator
+/// commit, and an operator who accepts the star pick (Enter) would be told
+/// the same refusal forever with nothing about the position ever changing --
+/// that was `harness::play::tests::resync_demands_a_cause_and_taints_the_game`'s
+/// hang. Deeper search below the root (`plan::rank`/`one_ply_scored`) still
+/// explores `PrepareEvent` freely -- it only ever sees the cloned
+/// `GameState`, never `Board::confirmed_events`, by design (this module's
+/// top doc comment on why the refusal cannot live in `apply.rs`) -- this
+/// helper only keeps it out of what the advisor ever OFFERS to commit.
+fn confirmed_legal_moves(board: &Board) -> Vec<Move> {
+    let moves = legal::legal_moves(&board.state);
+    if board.confirmed_events > 0 {
+        return moves.as_slice().to_vec();
+    }
+    moves.as_slice().iter().copied().filter(|m| !matches!(m, Move::PrepareEvent { .. })).collect()
+}
