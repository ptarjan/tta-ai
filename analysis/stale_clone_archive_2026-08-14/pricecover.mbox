-
-fn write_header(out: &mut impl Write) -> Result<(), String> {
-    let mut cols: Vec<&'static str> = vec!["game_id", "players", "seat", "round"];
-    for &k in WeightKey::ALL {
-        cols.push(k.name());
-    }
-    cols.push("win");
-    cols.push("final_score");
-    cols.push("final_rank");
-    writeln!(out, "{}", cols.join("\t")).map_err(|e| e.to_string())
-}
-
-/// 1-based rank by `scores[seat]` among `scores`, ties sharing the BETTER
-/// rank (a 3-way tie for first is rank 1 for all three, and the next distinct
-/// score is rank 4) -- the standard "competition ranking" convention.
-fn rank_of(scores: &[i32], seat: usize) -> usize {
-    let my = scores[seat];
-    1 + scores.iter().filter(|&&s| s > my).count()
-}
-
-fn write_row(out: &mut impl Write, meta: &GameMeta, seat: u8, round: u16, feats: &[f64], scores: &[i32]) -> Result<(), String> {
-    let my_score = scores[seat as usize];
-    let best = scores.iter().copied().max().unwrap_or(my_score);
-    let win = if my_score == best { 1 } else { 0 };
-    let rank = rank_of(scores, seat as usize);
-
-    let mut fields: Vec<String> = vec![meta.id.clone(), meta.players.to_string(), seat.to_string(), round.to_string()];
-    for &v in feats {
-        fields.push(format!("{v}"));
-    }
-    fields.push(win.to_string());
-    fields.push(my_score.to_string());
-    fields.push(rank.to_string());
-    writeln!(out, "{}", fields.join("\t")).map_err(|e| e.to_string())
-}
-
-fn run(index_path: &str, journals_dir: &str, out: &mut impl Write) -> Result<Stats, String> {
-    let games = corpus::parse_index(index_path)?;
-    let card_index = build_card_index();
-    // The champion's own numbers -- freezes the ten identity-aware,
-    // otherwise-bilinear coordinates `linear_features`'s own doc comment
-    // names (`HandPotential`, `WonderPotential`, ... `MyEventThreat`), the
-    // same choice `bots::weighted::eval::tests::
-    // linear_features_dotted_with_a_weight_vector_reproduces_evaluate_exactly`
-    // and `bin/agreefit.rs`'s champion-vs-fitted comparison both already
-    // make.
-    let freeze = Weights::default();
-
-    let mut stats = Stats::default();
-    write_header(out)?;
-
-    for meta in &games {
-        stats.games_total += 1;
-        let path = format!("{journals_dir}/{}.tsv", meta.id);
-        let text = match fs::read_to_string(&path) {
-            Ok(t) => t,
-            Err(_) => {
-                stats.games_no_journal += 1;
-                continue;
-            }
-        };
-        let result = replay_game(meta, &text, &card_index, true);
-        let scores = match &result.engine_scores {
-            Some(s) => s,
-            None => {
-                stats.games_no_outcome += 1;
-                continue;
-            }
-        };
-        stats.games_used += 1;
-        *stats.by_players.entry(meta.players).or_insert(0) += 1;
-
-        for d in &result.decisions {
-            let idx = d.state.decider();
-            let ctx = rivals::rival_context(&d.state, idx, None, None);
-            let feats = linear_features(&d.state, idx, Some(&ctx), &freeze);
-            write_row(out, meta, idx, d.state.round, &feats, scores)?;
-            stats.decisions_written += 1;
-        }
-    }
-
-    Ok(stats)
-}
-
-fn main() -> ExitCode {
-    let argv: Vec<String> = env::args().skip(1).collect();
-    if argv.len() != 2 {
-        eprintln!("usage: leafdump <index.tsv> <journals_dir>");
-        return ExitCode::FAILURE;
-    }
-    let stdout = io::stdout();
-    let mut out = io::BufWriter::new(stdout.lock());
-    match run(&argv[0], &argv[1], &mut out) {
-        Ok(stats) => {
-            if let Err(e) = out.flush() {
