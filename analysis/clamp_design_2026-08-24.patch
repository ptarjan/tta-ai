+/// Return `(weights, violations)` with every movable coordinate pulled back
+/// inside its own [`WeightKey::clamp_bound`].
+///
+/// `bin/climb.rs`'s mutation operators enforce this on every step, but a
+/// champion loaded from disk never went through them -- it may have been
+/// hand-edited, carried over from before this bound existed, or (as of this
+/// bound landing) simply pre-date it: the three live champions in
+/// `experiments/` each already have at least one coordinate sitting at the
+/// OLD flat `CLAMP = 60.0` (`food_stock`/`resource_stock`/`blue_free` in the
+/// 3p file), which is now out of bounds for those specific keys. Repairing
+/// silently rather than returning an `Err` matches [`dominance_repair`]'s
+/// existing precedent immediately above (same "repair on load, don't
+/// reject" philosophy, same `Violation` list for the caller to log loudly)
+/// and, unlike a hard error, does not brick every champion this repo
+/// currently has the moment this bound lands. Pure and idempotent, same as
+/// `dominance_repair`: a coordinate already inside its own bound is
+/// returned unchanged.
+///
+/// `FROZEN` (`bin/climb.rs`) is a mutation-time concept, not a load-time
+/// one -- `Culture` gets the same repair as every other key here, so a
+/// corrupt or hand-edited file cannot smuggle in a numeraire that rescales
+/// the whole evaluation.
+pub fn clamp_repair(w: &Weights) -> (Weights, Vec<Violation>) {
+    let mut out = *w;
+    let mut viol = Vec::new();
+    for &k in WeightKey::ALL {
+        let bound = k.clamp_bound();
+        let v = out.get(k);
+        if v.abs() > bound {
+            viol.push(Violation {
+                weight: k,
+                value: v,
+                default: k.default_weight(),
+                rule: format!("|{}| <= {bound} (WeightKey::clamp_bound)", k.name()),
+            });
+            out.set(k, bound.copysign(v));
+        }
+    }
+    (out, viol)
+}
+
