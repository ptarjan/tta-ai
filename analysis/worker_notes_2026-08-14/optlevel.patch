diff --git a/rust/Cargo.toml b/rust/Cargo.toml
index 875ca18..f7fe964 100644
--- a/rust/Cargo.toml
+++ b/rust/Cargo.toml
@@ -94,7 +94,38 @@ inherits = "release"
 inherits = "release"
 debug-assertions = true
 lto = false
-codegen-units = 16
+codegen-units = 256
+opt-level = 0
+# `inherits = "release"` pulls in opt-level = 3, which is the wrong trade for
+# this profile: the whole point of `difftest` is a fast edit-test loop, and
+# nearly all of that loop's cost is compiling, not running -- the test suite
+# itself runs in low single-digit seconds even at opt-level 3, so there is
+# enormous headroom to spend run speed to buy compile speed.
+#
+# Measured on this box 2026-08-14 (clean clone, `--lib --test suite`, one
+# real one-line edit inside `effects::compute()`, a function called from 18
+# files -- a bare `touch` does NOT reproduce a real edit: rustc's incremental
+# system hashes content, so a no-op touch or a comment-only change recompiles
+# almost nothing and is not representative):
+#   opt-level | codegen-units | compile (s) | run: lib+suite wall (s) | total
+#       3     |      16       |    111.9    |          4.1            | 116.0  (old default)
+#       1     |      16       |     97.2    |          4.4            | 101.6
+#       0     |      16       |     22.1    |         34.3            |  56.4
+#       0     |     256       |     13.2    |         33.2            |  46.4  <- adopted
+# codegen-units = 256 is cheap insurance on top of opt-level = 0: it shaves
+# another ~9s off compile (more, smaller units to schedule across cores) at
+# no measurable run-time cost, since there's almost no optimization happening
+# to lose by splitting units further.
+# `debug = 0` was also tried on top of the opt-level=0/cgu=256 combination and
+# measured within noise of leaving it unset (43.0s vs 46.4s total, i.e. not a
+# real effect): `cargo build -v` shows this profile already passes rustc
+# `-C strip=debuginfo` under the inherited release defaults, so debug info is
+# already being stripped and setting `debug = 0` explicitly is redundant.
+# Left out for that reason -- don't re-add it without new evidence.
+# All test suites still pass at opt-level = 0 (1355 lib + 10 integration, 0
+# failed) -- debug-assertions stays true throughout, so this is not trading
+# away the assertion safety net, only optimization.
+#
 # Incremental compilation caches per-codegen-unit object code, so an edit
 # re-codegens only the units it actually touched -- the closest thing Rust has
 # to C's "recompile one .o and relink", and worth having precisely because this
