+            out.as_slice().contains(&Move::BachTheater { from: card("Theology"), to: card("Drama") }),
+            "an action card's own ordered urban-upgrade must also offer Bach's cross-kind \
+             theater upgrade, not just a bare same-kind Upgrade: {:?}",
+            out.as_slice()
+        );
+    }
