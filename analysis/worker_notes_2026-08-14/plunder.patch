+        let out = apply_one(&mut r, 0, ActionClass::PlayAggression, Some(plunder_i), "plays Plunder against Purple Your rival loses a total of up to 7 resource and/or food (your choice). You gain that many resource and food.; ; Orange uses 1 military action", raw, None);
+
+        assert!(out.is_ok(), "{out:?}");
