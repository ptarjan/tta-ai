+        // own `politics_moves`, `CardType::Aggression` arm), not Actions.
+        r.state.phase = Phase::Politics;
+        r.state.round = 2; // round 1 legally offers only `Take`/`EndTurn` (§1.9)
+        r.state.age_civil = crate::cards::Age::III;
+        let plunder_i = CardId::by_name("Aggression: Plunder (I)").expect("in the table");
+        let warriors = CardId::by_name("Warriors").expect("in the table");
+        {
+            let attacker = &mut r.state.players[0];
+            attacker.military_actions = 1;
+            // `legal::legal_moves` only offers `Move::Aggression` when the
+            // attacker is STRICTLY stronger (`combat::attack_strength` >
+            // `combat::defense_strength`, both 0 by default) -- give the
+            // attacker some real strength via built Warriors (already in
+            // every new game's starting tableau, `game::new_game`, so this
+            // sets its worker count rather than re-inserting it).
+            attacker
+                .techs
+                .get_mut(warriors)
+                .expect("Warriors is in every new game's starting tableau")
+                .workers = 3;
+        }
+        {
+            let defender = &mut r.state.players[1];
+            // No `hand_military` at all -- `interact::start_defense` then
