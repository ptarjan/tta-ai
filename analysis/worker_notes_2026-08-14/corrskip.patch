+/// `(food, mine)` [`Denoms::of`] snapshots for [`PlayerState::
+/// turn_start_denoms`] -- called once per player per turn, from
+/// `game::start_turn`, before that turn's own civil actions can develop or
+/// upgrade a Farm/Mine card. Not used by [`blue_used`]/[`blue_available`]
+/// themselves (gaining/paying legitimately reads the LIVE tableau -- see
+/// [`gain`]'s own doc); only the corruption step needs the frozen copy, via
+/// [`blue_used_committed`].
+pub(crate) fn turn_start_denoms_snapshot(techs: &Tableau) -> TurnStartDenoms {
+    let (food, food_len) = Denoms::of(techs, CardType::Farm).snapshot();
+    let (mine, mine_len) = Denoms::of(techs, CardType::Mine).snapshot();
+    TurnStartDenoms { food, food_len, mine, mine_len }
+}
+
+/// The [`blue_used`] a corruption check (§6.2, `end_of_turn` step 3b) must
+/// use: farm/mine denominations FROZEN as of the start of this player's own
+/// turn ([`PlayerState::turn_start_denoms`] -- see its own doc for the
+/// corpus-confirmed bug this closes), not `p.techs` live. Stock levels
+/// (`p.food`/`p.resources`) and wonder steps are still read live -- only the
+/// denominations are frozen, exactly mirroring [`blue_used`] otherwise.
+///
+/// `pub(crate)`, not private: `replay_common.rs`'s `record_corruption_check`
+/// reproduces this SAME computation ahead of `end_of_turn` actually running,
+/// and its own doc comment promises it stays byte-for-byte identical to
+/// what `end_of_turn` is about to do internally -- see there.
+pub(crate) fn blue_used_committed(p: &PlayerState) -> u16 {
+    let d = &p.turn_start_denoms;
+    let food_denoms = if d.food_len > 0 {
+        Denoms::from_raw(d.food, d.food_len)
+    } else {
+        Denoms::of(&p.techs, CardType::Farm)
+    };
+    let mine_denoms = if d.mine_len > 0 {
+        Denoms::from_raw(d.mine, d.mine_len)
+    } else {
+        Denoms::of(&p.techs, CardType::Mine)
+    };
+    let food_tokens = tokens_for(p.food, food_denoms.as_slice());
+    let mine_tokens = tokens_for(p.resources, mine_denoms.as_slice());
+    let mut used = food_tokens + mine_tokens;
+    if !p.wonder.is_none() {
+        used += p.wonder_steps as u16;
+    }
+    if crate::debugflags::replay_debug_all() {
+        eprintln!(
+            "DEBUG blue_used_committed: food={} food_denoms={:?} food_tokens={food_tokens} resources={} mine_denoms={:?} mine_tokens={mine_tokens} wonder={} wonder_steps={} total={used}",
+            p.food, food_denoms.as_slice(), p.resources, mine_denoms.as_slice(),
+            if p.wonder.is_none() { "none" } else { p.wonder.get().name }, p.wonder_steps
+        );
+    }
+    used
+}
