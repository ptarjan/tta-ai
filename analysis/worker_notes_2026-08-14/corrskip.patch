+            p.yellow_bank = 17; // consumption 0, happy_required 0 -- isolates step 3b
+            p.blue_total = 16;
+            p.food = 2; // placed on Agriculture (denom 1) before this turn
+            p.resources = 4; // placed on Bronze (denom 1), unaffected either way
+            p.techs.insert(card("Agriculture"), TechSlot { workers: 0, stored: 0 });
+            p.techs.insert(card("Bronze"), TechSlot { workers: 0, stored: 0 });
