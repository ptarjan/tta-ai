<?xml version="1.0" encoding="UTF-8"?>
<!-- TtA gaming guard.  Three things were wrong with the previous registration:

     1. The only trigger was LogonTrigger with a <Repetition> that had no
        <Duration>.  Task Scheduler silently drops such a repetition
        (`schtasks /query` reported "Repeat: Every: N/A"), so the task ran
        exactly once at logon.  When the guard process was killed on
        2026-07-29 it stayed dead  ;  Last Result -1, Status Ready, last run two
        days earlier  ;  and with no guard running a gaming session could not be
        detected at all.  A guard that cannot restart is not a guard.  Fixed
        with a CalendarTrigger that repeats every 5 minutes all day, every day;
        the guard's own PID lock makes the extra starts cheap no-ops.

     2. The action ran a .cmd directly under an interactive token, which pops a
        console window.  Now routed through tools/hidden_launch.vbs.

     3. No BootTrigger equivalent, so the guard depended entirely on an
        interactive logon having happened.  The daily CalendarTrigger with
        StartWhenAvailable covers that too.

     Priority 5 = NORMAL on purpose.  The guard must be scheduled promptly to
     notice a game even while the box is saturated by training; it polls every
     15 s and costs nothing.  Training runs at 7 (below normal) instead. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>TtA gaming guard: pauses+kills training when a game uses the GPU. Self-restarting every 5 min.</Description></RegistrationInfo>
  <Triggers>
    <LogonTrigger><Enabled>true</Enabled></LogonTrigger>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
      <Repetition>
        <Interval>PT5M</Interval>
        <Duration>P1D</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>micro</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <Hidden>true</Hidden>
    <RestartOnFailure><Interval>PT1M</Interval><Count>999</Count></RestartOnFailure>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>5</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>wscript.exe</Command>
      <Arguments>//B //Nologo "C:\Users\micro\tta-ai\tools\hidden_launch.vbs" "C:\Users\micro\tta-ai\run_guard.cmd"</Arguments>
      <WorkingDirectory>C:\Users\micro\tta-ai</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
